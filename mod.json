{
  "geode": "5.11.2",
  "gd": { "android": "2.2081", "win": "2.2081" },
  "id": "martin.predictive-buffer-android",
  "name": "Input Buffer (Android)",
  "version": "v1.0.0",
  "developer": "Martin Elias",
  "description": "Buffer de clicks: si presionas unos ticks antes de tiempo, el click se guarda y se ejecuta al aterrizar o tocar un orb.",
  "settings": {
    "enabled": { "type": "bool", "name": "Activado", "default": true },
